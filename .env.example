# 源码启动的可选配置。需要修改默认值时，复制为项目根目录的 .env，
# 再取消相应行的注释。模型 API Key 在「设置 → 模型」中配置。

# daemon 日志级别，默认为 info。
# CWPI_LOG_LEVEL=info

# 自定义 SQLite 数据库位置时，建议填写绝对路径。
# CWPI_DATABASE_PATH=

# 本机 SearXNG 地址，默认为 http://127.0.0.1:8888。
# CWPI_WEB_SEARCH_URL=http://127.0.0.1:8888

# Docker Compose 默认会自动生成 SearXNG 密钥。仅在需要指定自己的密钥时填写。
# SEARXNG_SECRET=

# 自行注册插件 OAuth 应用时，按需填写对应的一对 Client ID 和 Client Secret。
# CWPI_SKILL_GITHUB_CLIENT_ID=
# CWPI_SKILL_GITHUB_CLIENT_SECRET=
# CWPI_SKILL_GOOGLE_CLIENT_ID=
# CWPI_SKILL_GOOGLE_CLIENT_SECRET=
# CWPI_SKILL_NOTION_CLIENT_ID=
# CWPI_SKILL_NOTION_CLIENT_SECRET=
# CWPI_SKILL_SUPABASE_CLIENT_ID=
# CWPI_SKILL_SUPABASE_CLIENT_SECRET=
# CWPI_SKILL_VERCEL_CLIENT_ID=
# CWPI_SKILL_VERCEL_CLIENT_SECRET=
