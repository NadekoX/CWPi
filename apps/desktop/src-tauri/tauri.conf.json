{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CWPi",
  "version": "../package.json",
  "identifier": "com.cwpi.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs",
    "beforeBuildCommand": "pnpm prepare:bundle",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CWPi",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
